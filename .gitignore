# .gitignore for Java (Maven) project
# Generated by assistant: ignores build artifacts, IDE files, OS files, secrets, and other local files

# Maven / Build
/target/
**/target/
/generated-sources/

# Compiled class files
*.class

# Package files
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IntelliJ IDEA
/.idea/
*.iml
*.iws
out/

# VS Code
.vscode/

# Eclipse
.classpath
.project
.settings/

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# Local env / secrets
.env
.env.*
*.env
credentials.properties
local.properties
secrets/
*.secret

# Keystore / private keys
*.jks
*.keystore
*.p12
*.pem
*.crt
*.key

# Test reports / coverage
coverage/
jacoco.exec
/target/site/jacoco/
**/surefire-reports/
**/failsafe-reports/

# Temporary files
tmp/
temp/
*.tmp
*.temp

# Databases
*.db
*.sqlite

# Node modules (if any present)
node_modules/

# Docker overrides/local config (do not commit local overrides)
docker-compose.override.yml

# Misc
*.log
*.class

# Keep the Maven wrapper scripts tracked but ignore wrapper cache
.mvn/wrapper/maven-wrapper.jar
.mvn/wrapper/maven-wrapper.properties

# If you add IDE-specific run configs or workspace files, consider ignoring them as well
# End of file

